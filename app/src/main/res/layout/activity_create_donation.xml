<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F9FD">


    <!-- TOOLBAR -->

    <androidx.appcompat.widget.Toolbar

        android:id="@+id/toolbarDonation"

        android:layout_width="match_parent"

        android:layout_height="?attr/actionBarSize"

        android:background="#0284C7"

        app:title="Quyên góp ủng hộ"

        app:titleTextColor="@android:color/white"

        app:navigationIcon="?attr/homeAsUpIndicator"

        app:layout_constraintTop_toTopOf="parent"/>




    <ScrollView

        android:layout_width="match_parent"

        android:layout_height="0dp"

        android:fillViewport="true"

        app:layout_constraintTop_toBottomOf="@id/toolbarDonation"

        app:layout_constraintBottom_toBottomOf="parent">



        <androidx.constraintlayout.widget.ConstraintLayout

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:padding="16dp">



            <!-- FORM -->

            <androidx.constraintlayout.widget.ConstraintLayout

                android:id="@+id/layoutFormInput"

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:background="@drawable/bg_card"

                android:padding="18dp"

                app:layout_constraintTop_toTopOf="parent">



                <TextView

                    android:id="@+id/txtHeader"

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="ĐỒNG HÀNH CÙNG ĐÔNG ẤM HAUI"

                    android:textSize="20sp"

                    android:textStyle="bold"

                    android:textColor="#0369A1"

                    app:layout_constraintStart_toStartOf="parent"

                    app:layout_constraintEnd_toEndOf="parent"

                    app:layout_constraintTop_toTopOf="parent"/>



                <EditText

                    android:id="@+id/edtDonorName"

                    android:layout_width="match_parent"

                    android:layout_height="55dp"

                    android:layout_marginTop="20dp"

                    android:hint="Họ và tên người quyên góp"

                    android:padding="14dp"

                    android:textSize="15sp"

                    android:background="@drawable/bg_edittext"

                    app:layout_constraintTop_toBottomOf="@id/txtHeader"/>




                <RadioGroup

                    android:id="@+id/radioGroupType"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:orientation="horizontal"

                    android:layout_marginTop="18dp"

                    app:layout_constraintTop_toBottomOf="@id/edtDonorName">



                    <RadioButton

                        android:id="@+id/radMoney"

                        android:layout_width="0dp"

                        android:layout_weight="1"

                        android:layout_height="50dp"

                        android:text="💙 Quyên góp tiền"

                        android:textColor="#0F172A"

                        android:buttonTint="#0284C7"

                        android:checked="true"/>



                    <RadioButton

                        android:id="@+id/radItem"

                        android:layout_width="0dp"

                        android:layout_weight="1"

                        android:layout_height="50dp"

                        android:text="🎁 Hiện vật"

                        android:textColor="#0F172A"

                        android:buttonTint="#0284C7"/>


                </RadioGroup>




                <EditText

                    android:id="@+id/edtMoneyAmount"

                    android:layout_width="match_parent"

                    android:layout_height="55dp"

                    android:layout_marginTop="15dp"

                    android:hint="Nhập số tiền quyên góp (VNĐ)"

                    android:inputType="number"

                    android:padding="14dp"

                    android:background="@drawable/bg_edittext"

                    app:layout_constraintTop_toBottomOf="@id/radioGroupType"/>




                <LinearLayout

                    android:id="@+id/layoutItemFields"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:orientation="horizontal"

                    android:visibility="gone"

                    android:layout_marginTop="15dp"

                    app:layout_constraintTop_toBottomOf="@id/radioGroupType">



                    <EditText

                        android:id="@+id/edtItemName"

                        android:layout_width="0dp"

                        android:layout_height="55dp"

                        android:layout_weight="2"

                        android:hint="Tên vật phẩm"

                        android:background="@drawable/bg_edittext"/>



                    <EditText

                        android:id="@+id/edtItemQty"

                        android:layout_width="0dp"

                        android:layout_height="55dp"

                        android:layout_weight="1"

                        android:layout_marginStart="8dp"

                        android:hint="SL"

                        android:inputType="number"

                        android:background="@drawable/bg_edittext"/>


                </LinearLayout>




                <EditText

                    android:id="@+id/edtMessage"

                    android:layout_width="match_parent"

                    android:layout_height="100dp"

                    android:layout_marginTop="18dp"

                    android:hint="Lời nhắn gửi tới các em nhỏ vùng cao"

                    android:gravity="top"

                    android:padding="14dp"

                    android:background="@drawable/bg_edittext"

                    app:layout_constraintTop_toBottomOf="@id/edtMoneyAmount"/>





                <Button

                    android:id="@+id/btnSubmitDonation"

                    android:layout_width="match_parent"

                    android:layout_height="55dp"

                    android:layout_marginTop="25dp"

                    android:text="TIẾP TỤC QUYÊN GÓP"

                    android:textColor="@android:color/white"

                    android:textStyle="bold"

                    android:backgroundTint="#0284C7"

                    app:layout_constraintTop_toBottomOf="@id/edtMessage"/>


            </androidx.constraintlayout.widget.ConstraintLayout>






            <!-- QR PAYMENT -->


            <LinearLayout

                android:id="@+id/layoutQrPayment"

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:gravity="center"

                android:visibility="gone"

                android:padding="20dp"

                android:background="#FFFFFF"

                android:layout_marginTop="20dp"

                app:layout_constraintTop_toBottomOf="@id/layoutFormInput">



                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="QUÉT MÃ QR ĐỂ CHUYỂN KHOẢN"

                    android:textSize="17sp"

                    android:textStyle="bold"

                    android:textColor="#0369A1"/>




                <ImageView

                    android:id="@+id/imgQrCode"

                    android:layout_width="220dp"

                    android:layout_height="220dp"

                    android:layout_marginTop="15dp"

                    android:background="#E0F2FE"

                    android:src="@drawable/ic_launcher_background"/>




                <TextView

                    android:id="@+id/txtQrAmount"

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="Số tiền: 0 VNĐ"

                    android:textSize="16sp"

                    android:textStyle="bold"

                    android:textColor="#0284C7"

                    android:layout_marginTop="15dp"/>




                <TextView

                    android:id="@+id/txtQrContent"

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="Nội dung chuyển khoản"

                    android:textColor="#334155"

                    android:layout_marginTop="8dp"/>




                <Button

                    android:id="@+id/btnConfirmPayment"

                    android:layout_width="match_parent"

                    android:layout_height="55dp"

                    android:layout_marginTop="20dp"

                    android:text="ĐÃ CHUYỂN KHOẢN"

                    android:textColor="@android:color/white"

                    android:backgroundTint="#0284C7"/>


            </LinearLayout>



        </androidx.constraintlayout.widget.ConstraintLayout>


    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>