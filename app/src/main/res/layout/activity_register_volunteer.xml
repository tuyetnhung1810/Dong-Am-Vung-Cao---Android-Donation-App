<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5FAFF">


    <!-- Toolbar -->

    <androidx.appcompat.widget.Toolbar

        android:id="@+id/toolbarVolunteer"

        android:layout_width="match_parent"
        android:layout_height="56dp"

        android:background="#0284C7"

        app:title="Đăng ký tình nguyện viên"

        app:titleTextColor="@android:color/white"

        app:navigationIcon="?attr/homeAsUpIndicator"/>



    <ScrollView

        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:padding="16dp">


        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical">

            <!-- Banner -->

            <androidx.cardview.widget.CardView

                android:layout_width="match_parent"
                android:layout_height="160dp"

                app:cardCornerRadius="18dp"

                app:cardElevation="5dp">

                <ImageView

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:scaleType="centerCrop"

                    android:src="@drawable/volunteer"/>


            </androidx.cardview.widget.CardView>

            <!-- Title -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Cùng HaUI lan tỏa yêu thương"

                android:textSize="22sp"

                android:textStyle="bold"

                android:textColor="#0284C7"

                android:gravity="center"

                android:layout_marginTop="18dp"/>



            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Đăng ký tham gia các hoạt động tình nguyện vùng cao"

                android:textSize="14sp"

                android:textColor="#64748B"

                android:gravity="center"

                android:layout_marginTop="8dp"

                android:layout_marginBottom="20dp"/>


            <!-- Form -->

            <androidx.cardview.widget.CardView

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                app:cardCornerRadius="20dp"

                app:cardElevation="4dp"

                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="18dp">

                    <!-- Time -->


                    <TextView

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:text="Thời gian có thể tham gia"

                        android:textSize="16sp"

                        android:textStyle="bold"

                        android:textColor="#0F172A"/>

                    <Spinner

                        android:id="@+id/spnTimeSlot"

                        android:layout_width="match_parent"

                        android:layout_height="52dp"

                        android:layout_marginTop="10dp"

                        android:background="@drawable/bg_spinner"/>



                    <!-- Campaign -->


                    <TextView

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:text="Chiến dịch muốn tham gia"

                        android:textSize="16sp"

                        android:textStyle="bold"

                        android:textColor="#0F172A"

                        android:layout_marginTop="22dp"/>



                    <Spinner

                        android:id="@+id/spnCampaigns"

                        android:layout_width="match_parent"

                        android:layout_height="52dp"

                        android:layout_marginTop="10dp"

                        android:background="@drawable/bg_spinner"/>




                    <!-- Message -->


                    <TextView

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:text="Lời nhắn / Kỹ năng hỗ trợ"

                        android:textSize="16sp"

                        android:textStyle="bold"

                        android:textColor="#0F172A"

                        android:layout_marginTop="22dp"/>



                    <EditText

                        android:id="@+id/edtVolunteerMessage"

                        android:layout_width="match_parent"

                        android:layout_height="120dp"

                        android:layout_marginTop="10dp"

                        android:background="@drawable/bg_edittext"

                        android:hint="Ví dụ:
Hỗ trợ hậu cần
Chụp ảnh hoạt động
Vận chuyển đồ"

                        android:textSize="15sp"

                        android:padding="15dp"

                        android:gravity="top|start"/>





                    <!-- Button -->


                    <com.google.android.material.button.MaterialButton

                        android:id="@+id/btnSubmitVolunteer"

                        android:layout_width="match_parent"

                        android:layout_height="58dp"

                        android:layout_marginTop="25dp"

                        android:text="ĐĂNG KÝ THAM GIA"

                        android:textSize="16sp"

                        android:textStyle="bold"

                        android:textColor="@android:color/white"

                        android:backgroundTint="#0284C7"

                        app:cornerRadius="16dp"/>



                </LinearLayout>


            </androidx.cardview.widget.CardView>


        </LinearLayout>


    </ScrollView>


</LinearLayout>