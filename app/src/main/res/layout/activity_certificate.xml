<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E293B"
    android:gravity="center">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarCert"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0284C7"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Chứng nhận của bạn"
        app:titleTextColor="@android:color/white"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="24dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ĐÔNG ẤM VÙNG CAO HaUI"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0284C7"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHỨNG NHẬN"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#EA580C"
                    android:layout_marginTop="12dp" />

                <View
                    android:layout_width="80dp"
                    android:layout_height="2dp"
                    android:background="#F97316"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trân trọng trao tặng cho hảo tâm:"
                    android:textSize="14sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="20dp"
                    android:textStyle="italic"/>

                <TextView
                    android:id="@+id/tvCertDonorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dương Hải Anh"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvCertContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đã đồng hành gây quỹ cùng chiến dịch thiện nguyện mang hơi ấm tình thương tới trẻ em nghèo vùng cao."
                    android:textSize="14sp"
                    android:textColor="#334155"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"/>

                <ImageView
                    android:id="@+id/imgCertQr"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="24dp"
                    android:src="@android:drawable/ic_menu_crop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quét mã để xem chi tiết hành trình"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="6dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="24dp"/>

                <TextView
                    android:id="@+id/tvCertDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ngày cấp: 14/06/2026"
                    android:textSize="11sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
</LinearLayout>